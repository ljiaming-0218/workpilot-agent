# Copy to .env and fill in your local MySQL credentials. Do not commit .env.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD="your_mysql_password"
MYSQL_DATABASE=workpilot_agent
MYSQL_CONNECT_TIMEOUT=5
# Optional CA bundle for a managed MySQL-compatible service.
MYSQL_SSL_CA=

# Phase 4 LLM settings. Keep the real API key only in .env.
LLM_API_KEY="your_llm_api_key"
LLM_BASE_URL=
LLM_MODEL="your_model_name"
# Free hosted models may cold-start; increase this if requests time out.
LLM_TIMEOUT=90
LLM_MAX_RETRIES=2
# Qwen 3/3.5 OpenAI-compatible endpoints can disable reasoning for JSON tasks.
LLM_ENABLE_THINKING=true
